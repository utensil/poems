#{
  let title = "屡战"
  let poem_lines = ("筹营后方不甘寂，", "杂中炼精视非途。", "弃者岂能垮我辈，", "再塑箫规重上路。")
  let context_note = "团队成员提出离职所作。"
  let commentary = ("【人工修订未完成，仅供参考】", "题为「屡战」——屡次的战。诗人在创作背景中已点明此作之处境：团队成员提出离职。一桩寻常之事却被置于「战」的语汇之中。此作四句七言，前两句记诗人原本之状，后两句承认所失之伴并立出再战之意。", "「筹营后方不甘寂」，起句立诗人之位。「筹营」是筹划经营之事，「后方」相对前线而言；「不甘寂」三字尤为关键——一个本应安于后方筹划的人，心却不甘寂寞。诗人不愿做一个静默的后方筹谋者。", "「杂中炼精视非途」，第二句进入诗人的方法。「杂中炼精」是于繁杂中提炼精华——这是后方之人的本事；「视非途」三字承前句的「不甘寂」——把这条「在杂中炼精」之路视为非己之路。诗人不满于在杂事中等出精华——他更想直接到前线去。", "「弃者岂能垮我辈」，第三句忽然让位至当下离职之事。「弃者」是指那些选择放弃、离开团队之人；「岂能垮我辈」三字尤为有力——「岂能」是反问之词，带着不容置疑的语气。诗人不否认离去者所留下的损伤，却以反问的方式立起一个声明：他们不能让我们倒下。", "「再塑箫规重上路」，末句以一桩极具体的动作收住全诗。「箫规」承「萧规曹随」之古典——萧何制定的规章，曹参承袭之；「再塑箫规」即重新立定章程。「重上路」三字尤为干净：人走，规破，则重新立规，重新出发。", "四句的弧由诗人之心（不甘寂/视非途）至当下之事（弃者/岂能垮）至应对（再塑/上路）。诗人未抒愤怒，亦未挽留，只让前两句的「不甘寂」与后两句的「再塑」承接为同一种气性——既不安于后方之寂，亦不被弃者所垮。题为「屡战」——离去并非战之终，而是又一次战之始。")
  let asset = "assets/poems/屡战/illustration.png"
  let override = ("重": "chóng")
  render-poem(title, poem_lines, context_note, commentary, asset, override)
}
