#{
  let title = "断舍"
  let poem_lines = ("远景渐朗继有人，", "重燃狼性断舍离。", "案头宗卷恍隔世，", "再铺新纸染心血。")
  let context_note = "组织上安排转岗所作。"
  let commentary = ("【人工修订未完成，仅供参考】", "题为「断舍」——断的是与旧事的关系，舍的是已建之业。诗人在创作背景中已点明：组织上安排转岗。此作四句七言，前两句记交接之释，后两句承认新事的从零开始。", "「远景渐朗继有人」，起句立交接之时的远景。「远景渐朗」是项目的长远图景越来越清晰，「继有人」是后续有承接之人——这是离任前最重要的两件事：方向已定、接班已立。诗人不是在事情未明的时候离开，而是在已可放手之时被调走。", "「重燃狼性断舍离」，第二句立心的姿态。「重燃」是再一次点燃，「狼性」承当代职场的语汇——指敏锐进取之态；「断舍离」三字承日本作家山下英子之古典化用法——对旧物之持的三重断绝。诗人在转岗的这一刻把当代两个语汇并入古典格律：重新点燃锐意之心，决绝地断、舍、离。", "「案头宗卷恍隔世」，第三句进入新岗的桌前。「案头」是新岗位的案头，「宗卷」是这一岗的主要文件——本应熟悉，但「恍隔世」三字尤为深沉：仿佛隔了一世。一个「恍」字尤为关键——并不是真的隔世，而是心中的状态像隔了一世。前一岗的熟悉感在此瞬间消失，新一岗的内容如外语般陌生。", "「再铺新纸染心血」，末句给出从零开始之姿。「再铺」是再次铺开，「新纸」是空白的纸——一切重新开始；「染心血」是把心血染在这张新纸上——前岗已染过一次，此刻再染一次。一个「再」字承接前句的「恍隔世」——既然如同新人，那便如新人一般再来一次。", "四句的弧由旧事（远景/继有人）至断舍（重燃/狼性）至新位之陌（案头/恍隔世）至再染（铺纸/染心血）。诗人未抒离去之惜，亦未求时间之缓——已朗的远景与已立的接班足以让心安离；新岗的恍隔世既被承认，便以再染心血回应。题为「断舍」——断舍并非冷漠的丢弃，是把心血从一张纸上挪到另一张纸上的整套动作。")
  let asset = "assets/poems/断舍/illustration.png"
  let override = ("重": "chóng", "卷": "juàn")
  render-poem(title, poem_lines, context_note, commentary, asset, override)
}
