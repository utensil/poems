#{
  let title = "心旗"
  let poem_lines = ("百挫得来倍珍惜，", "阻滞关头意须决。", "于无措中求巧解，", "为矢寻的践其约。")
  let context_note = "项目攻坚所作。"
  let commentary = ("【人工修订未完成，仅供参考】", "题为「心旗」——心中之旗，是项目攻坚时的精神标识。此作四句七言，记一桩攻坚阶段的内心姿态：所历之挫已多，所立之志却未弱。诗中四句皆以一个动作或姿态写心之自处。", "「百挫得来倍珍惜」，起句即立此前之路。「百挫」是已历的多次挫折，「倍珍惜」是承经过之难而生的对当下之珍。一个「倍」字让这份珍惜不是寻常的爱护，而是经过百挫之后特有的厚重。", "「阻滞关头意须决」，第二句承前句进入当下之态。「阻滞关头」是被堵住的关键时刻，「意须决」是意志必须决断。「须」字尤为吃紧——不是「可以」决，而是「必须」决；阻滞之处不容犹豫。", "「于无措中求巧解」，第三句状解决之路。「无措」是无办法之态，「巧解」是巧妙的破解之法。诗人不否认无措是真实的——但于此之中仍要去求巧解。「求」字带着主动性：不是等巧解出现，而是主动寻找。", "「为矢寻的践其约」，末句以箭与靶的关系收住全诗。「为矢」是把自己当作一支箭，「寻的」是去找那个靶子（「的」读 dì，作目标解）；「践其约」是兑现自己所立的约定。一个「为」字尤为关键——诗人主动把自己变成一支箭，而箭的天职是去找靶。前句的「求巧解」是方法上的主动，此句的「为矢」是身份上的主动。", "四句的弧由旧痛（百挫/珍惜）至当下之决（阻滞/须决）至求路（无措/巧解）至自任（为矢/践约）。一支自任为矢的姿态承担了全部的攻坚之意，胜负之论与外援之力皆不必先行讨论——心旗所标的不是胜利，是「为矢寻的」这一桩自任。")
  let asset = "assets/poems/心旗/illustration.png"
  let override = ("的": "dí")
  render-poem(title, poem_lines, context_note, commentary, asset, override)
}
