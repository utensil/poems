#{
  let title = "拭剑"
  let poem_lines = ("缩岛沉舟谐何妥，", "应付终托痂涩喜。", "誓绝因庸疑误己，", "择伙践志斩荆棘。")
  let context_note = "前两句背后的故事是在与人相处、职业发展等方面受挫后迎来转机。后两句是反思过程中的自我怀疑以及作为上的犹豫。"
  let commentary = ("【人工修订未完成，仅供参考】", "题为「拭剑」——拭擦剑身，是接战之前的整理动作。诗人在创作背景中已点明：前两句承前期受挫后的转机，后两句承反思中的自我怀疑与犹豫。此作四句七言，前两句记由挫至机，后两句立断疑之志。", "「缩岛沉舟谐何妥」，起句以两个极端之景立此前之困。「缩岛」是退至小岛之态，「沉舟」承《破釜沉舟》之古意——本是决死之姿，此处却带着一丝退守之态。「谐何妥」三字尤为艰：与谁相谐？何处可妥？一切退路与合作之处都成了未明之事。", "「应付终托痂涩喜」，第二句承前句之困立转机。「应付」是勉力应对的态度，「终托」是最终所托——所应付的一切终究有所归属；「痂涩喜」三字尤为微妙——「痂」是伤口结痂，「涩」是不顺滑，「喜」却是从这痂与涩中生出的一点喜色。转机不是清爽的胜利，而是带着结痂的、还未完全愈合的、却已开始好起来的状态。", "「誓绝因庸疑误己」，第三句进入反思与决断。「誓绝」是发誓断绝，「因庸」是因为平庸、因为犹豫不决；「疑误己」三字尤为锐——疑虑会误了自己。这一句的「誓绝」与第一句的「沉舟」构成两种「绝」——一是退路之绝（沉舟），一是自疑之绝（誓绝）。", "「择伙践志斩荆棘」，末句给出选择与行动。「择伙」是选择伙伴，「践志」是践行心志，「斩荆棘」是劈开前路之障。三个动作连陈：择人、立志、开路。前句的「誓绝因庸」是对内的决断，此句的「择伙践志」是对外的施为——内决之后即可外施。", "四句的弧由困（缩岛/沉舟）至机（终托/痂涩喜）至内决（誓绝/疑误）至外施（择伙/斩棘）。诗人未抒胜负之喜，亦未求外援，只让一桩从受挫到转机的全程在四句之内完成。题为「拭剑」——拭剑之意不仅是磨剑，更是磨那把心中的剑：先拭去自疑，然后才能斩开外面的荆棘。")
  let asset = "assets/poems/拭剑/illustration.png"
  let override = (:)
  render-poem(title, poem_lines, context_note, commentary, asset, override)
}
