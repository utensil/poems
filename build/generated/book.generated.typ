#{
  let title = "统帅"
  let poem_lines = ("倾采思量行果决，", "步子错落渐有致。", "登高远望酿山河，", "绳心养性融诸识。")
  let context_note = "有感于团队中长期规划对leader修养的要求而作。"
  let commentary = ("【人工修订未完成，仅供参考】", "题为「统帅」——领军之人。诗人在创作背景中已点明此作之处境：有感于团队中长期规划对 leader 修养的要求。此作四句七言，四句各立一桩 leader 之修养：决断、节奏、视野、内外合一。", "「倾采思量行果决」，起句立决断之要。「倾采」是广泛听取（倾听+采纳），「思量」是反复斟酌，「行果决」是行动果决。三个动作连陈：广听、思量之后即果决——一名 leader 的决断不是凭直觉，而是经过倾采与思量；但思量到位之后，决断必须果断。", "「步子错落渐有致」，第二句立节奏之要。「步子错落」是步伐有快有慢、有进有止；「渐有致」是逐渐形成自己的节奏。一个「致」字尤为关键——「致」是有趣味、有韵味，是节奏中含个性的状态。一名 leader 的步伐不是机械等距，而是错落有致——这种节奏感不是天生的，而是「渐」字所标记的逐步获得。", "「登高远望酿山河」，第三句立视野之要。「登高远望」是 leader 的本职动作——站到高处看远；「酿」字尤为出奇——「酿」是把素材慢慢发酵成新的东西，状视野不止是看，更是把所看之景酿成自己心中的山河。一个 leader 不仅要看见全局，还要在心中酿出自己对全局的理解。", "「绳心养性融诸识」，末句立内外合一之要。「绳心」是约束心，「养性」是修养性情，「融诸识」是融汇各种知识。三个动作并陈：内里的自律（绳心）、内里的修身（养性）、与外部知识的相融（融诸识）。前三句的决断、节奏、视野皆是对外的施为，此句把视线收回内里——leader 的外功之根，是内里的绳心、养性、融识。", "四句的弧由果决（决断）至节奏（步子）至视野（山河）至内里（绳心/养性）。诗人未求胜利之赞，亦未为权力立颂，只为「统帅」之位列出四项修养——皆是慢功夫，皆向内求。题为「统帅」——所统的是己身先于所帅之人，先治己而后帅众。")
  let asset = "assets/poems/统帅/illustration.png"
  let override = (:)
  render-poem(title, poem_lines, context_note, commentary, asset, override)
}
