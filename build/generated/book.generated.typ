#{
  let title = "型势"
  let poem_lines = ("宝剑初锋无当者，", "细琢日用千面同。", "鞘藏温养愈敛涵，", "逢境但出破长空。")
  let context_note = "在工作上挑战不够的阶段所作。"
  let commentary = ("【人工修订未完成，仅供参考】", "题为「型势」——「型」是器物之模子，「势」是力的方向。诗人在创作背景中已点明此作之处境：所处工作阶段挑战不够。此作四句七言，借宝剑入鞘的故事讲一个「未逢其时」的姿态。", "「宝剑初锋无当者」，起句即立位差。「初锋」是刚开锋的剑，「无当者」是没有可与之相对的对手。剑已成，敌却不在——一桩名器陷入无所施展之境。", "「细琢日用千面同」，第二句承前句之「无当者」。「细琢」是慢慢打磨，「日用」是用在日常杂务里，「千面同」三字尤为锐——一把宝剑被磨成千面相同的工具，当下用与他用之间没有差别。剑之所以为剑的特殊性，在日用的反复中被磨平。", "「鞘藏温养愈敛涵」，第三句给出诗人的应对。「鞘藏」是把剑收入鞘中，「温养」是不让其锋利过早暴露，「愈敛涵」三字尤为关键——「敛」是收缩，「涵」是包容，「愈」是越来越——越藏越敛，越敛越涵。剑不是被埋没，而是在鞘中继续养它的内里之深。", "「逢境但出破长空」，末句让所养之力一击而出。「逢境」是遇到合适的处境，「但出」是只要出鞘——一个「但」字带着一种确信，似乎并不担心鞘藏之久会损其锋。「破长空」三字承「龙泉之剑出鞘有声」之古意——一出鞘便破开苍空，所有积藏的力在此瞬间释放。", "四句的弧由「初锋」之锐至「日用」之磨至「鞘藏」之养至「破空」之释。诗人未怨当前之无敌，未求外界之识，只为自己定下一条退守之策：藏起来不是闲，是养。题为「型势」——型尚未遇其势之时，所要做的是把型继续养深。")
  let asset = "assets/poems/型势/illustration.png"
  let override = ("长": "cháng")
  render-poem(title, poem_lines, context_note, commentary, asset, override)
}
