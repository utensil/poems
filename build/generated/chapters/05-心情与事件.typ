#{
  let title = "心花"
  let poem_lines = ("花开招展冬日春，", "琉璃如镜映影只。", "心思渴望逾墙去，", "此身仍在樊笼中。")
  let context_note = ((kind: "para", text: "看到朋友圈上一张阳台上的花的照片，评论时随意所作。可按在职场里想象外出创业来理解。"),)
  let commentary = ("【人工修订未完成，仅供参考】", "诗人在创作背景中已示其双重读法：表面写阳台上一朵冬日开放之花，深层可借以读职场之中对外出创业的想象。此作四句七言，全篇借一朵花与一面玻璃的关系，状一种「想越而不能」的状态——花是想象之物，玻璃是现实之障。", "「花开招展冬日春」，起句立花之姿。「花开招展」是花开放且摆动之态，本是寻常之状；「冬日春」三字让这朵花的位置变得特别——隆冬之中，竟有一处属于春的局部。一花的存在，便是一个反季节的小春天。", "「琉璃如镜映影只」，第二句让花的位置具体化。「琉璃如镜」是窗玻璃的两重性——既透光，又映像。「映影只」三字尤为关键：玻璃映出的是「影只」——单影之状。诗人通过玻璃看花，看到的不仅是花，还有自己的孤影叠在花之上。", "「心思渴望逾墙去」，第三句陡然将主体由「景」转入「我」。「心思渴望」即心中所欲，「逾墙去」三字尤为生动——「墙」指阻隔自身与外界之物，「逾」是越过。心已经越过那堵墙，去到墙外那朵花的位置。", "「此身仍在樊笼中」，末句让心与身的位置撕开。「此身」承前句的「心思」之对——心已越墙，身仍在笼。「樊笼」承陶渊明《归园田居》「久在樊笼里，复得返自然」之古典意象，将职场处境压缩为一只笼。", "四句的弧由花（招展）至玻璃（映影）至心（逾墙）至身（在笼）。前两句是观察，后两句是自陈；前两句是外景，后两句是内里。诗人未抒怨，未求解，只让心与身被一面玻璃彻底分开。题为「心花」——心中之花已开放，如阳台之春；身却仍在那面看得见花却走不到花前的玻璃这一边。")
  let asset = "assets/poems/心花/illustration.png"
  let override = (:)
  render-poem(title, poem_lines, context_note, commentary, asset, override)
}
