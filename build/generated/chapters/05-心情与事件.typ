#{
  let title = "年心"
  let poem_lines = ("冬寒指日还春暖，", "雨雾朦胧先润街。", "年心似箭佳期近，", "一岁枯荣在此节。")
  let context_note = ((kind: "para", text: "去超市一趟所作。这还没到春节呢，雨就开始斜斜地下，周围的建筑物都笼罩在雾中，空气清新湿润，带来春意。盼着过年放假的心情，今年已不剩几天。古时，年过得好坏定调一年的年景，而现在，明年的战略项目Q1迭代也到了关键节点。"),)
  let commentary = ("【人工修订未完成，仅供参考】", "题为「年心」——年关将近的心绪。诗人在创作背景中已述明此作的双重时间感：古时新年定调一年之年景；当下之年关同时是工作迭代的关键节点。此作四句七言，将这种古今合一的「节」写于一桩极家常的小事——去超市途中遇雨。", "「冬寒指日还春暖」，起句立时间之转。「冬寒」是当下之冷，「春暖」是不远之暖；「指日」二字将这一段距离压缩到伸手可数的程度——较「望春」之远，已近至「指春」之及。一年之冬尾，已可触到春之首。", "「雨雾朦胧先润街」，第二句让风景代替时间陈述。「雨雾朦胧」是春意先到的征兆——春前之雨与春后之雨形态相同，但意味不同。「先润街」三字尤为含蓄——「先」字让此时之雨成为春的前驱：地面先湿，街气先润，然后才是春之到来。", "「年心似箭佳期近」，第三句直陈心绪。「年心」是诗人为此刻之心绪所造的复合词——「年」是节令，「心」是心绪，「年心」即年关之心。「似箭」承「光阴似箭」之古喻——但此处所形容的不是光阴，而是「心」——心已抢先到达节庆的边缘。「佳期近」三字让这份急切落地。", "「一岁枯荣在此节」，末句带着双重意味收住全诗。「一岁枯荣」是古人对一年之终的命名：一年之兴衰、一年之得失，皆在此一节。「在此节」三字尤为关键——「节」既是节庆（春节），也是节点（关键时刻）。古人意中的「定调一年之年景」与诗人意中的「Q1迭代关键节点」在此一字中合一。", "四句的弧由时间（指日还春暖）至景象（雨雾润街）至心绪（年心似箭）至定论（在此节）。诗人未直说所盼之假与所悬之事，但「年心似箭」与「在此节」之间已暗含全部张力——心已飞向假期，事却仍系于工作的节点。题为「年心」——年关之心兼有两重：盼归之喜与悬事之紧。")
  let asset = "assets/poems/年心/illustration.png"
  let override = ("还": "huán")
  render-poem(title, poem_lines, context_note, commentary, asset, override)
}
