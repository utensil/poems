#{
  let title = "心屿"
  let poem_lines = ("境迁人杳梦未离，", "访友抚琴感旧迹。", "纷繁汪洋留心屿，", "苍茫四顾慰孤旗。")
  let context_note = ((kind: "para", text: "访友忆昔所作。"),)
  let commentary = ("【人工修订未完成，仅供参考】", "题为「心屿」——心中之岛。访友怀旧之诗多落于人事变迁的感慨，此作却把那份感慨结晶为一座小岛：在纷繁的汪洋之中，仍有一处可以停歇之地。诗人未抒一字怨别，只让岛与旗这两个意象承担全部的留与问。", "「境迁人杳梦未离」，起句即立时间之差。「境迁」是地之改变，「人杳」是人之远去，二者并举已道尽变迁之实。然而「梦未离」三字陡然立起一丝牵连——外在的境与人皆已变，梦中之事却仍未离开。", "「访友抚琴感旧迹」，第二句进入具体之事。「访友」是当下之访，「抚琴」是友人或自己的弹奏；「感旧迹」三字尤为含蓄——所感不在琴声本身，而在琴声所唤起的旧迹。「迹」字承担了全句的位移：迹本是已过之痕，被琴声重新拨动起来。", "「纷繁汪洋留心屿」，第三句忽然将场景拉远。「纷繁汪洋」状外部世界之纷扰浩瀚，「留心屿」三字让这片汪洋之中仍有一处不被淹没的小岛——那便是心中所留的旧迹之处。「留」字带温——较「立」一座岛之主动，「留」字让岛的存在变成本然——岛比汪洋更早就在了。", "「苍茫四顾慰孤旗」，末句让岛上立起一面旗。「苍茫四顾」承前句的汪洋之意，状视野之寂；「孤旗」是岛上的标志——旗本是给远处看的，孤旗即此岛只剩一面旗在飘。「慰」字承担最后一笔——苍茫四顾之人，所慰者正是那面孤旗：知道还有这么一个标志在那里。", "四句的弧由境迁（汪洋）至琴声（旧迹）至心屿（留岛）至孤旗（慰）。诗人未否认变迁之实，亦未挽留逝去之事，只为自己留下一座岛、一面旗——岛是心中所容之地，旗是这地仍在的标志。题为「心屿」——汪洋虽广，心屿仍立；岛上人少，但旗未倒。")
  let asset = "assets/poems/心屿/illustration.png"
  let override = ("迹": "jì")
  render-poem(title, poem_lines, context_note, commentary, asset, override)
}
