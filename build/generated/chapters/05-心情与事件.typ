#{
  let title = "滋长"
  let poem_lines = ("迥廊椰玉柱，", "藤叶翠扶疏。", "柔蔓垂萦纡，", "谁知雨前初？")
  let context_note = ((kind: "para", text: "雨中漫步绿廊，有感于人际故事缘起而作。"),)
  let commentary = ("【人工修订未完成，仅供参考】", "题为「滋长」——慢慢生长。诗人在创作背景中已点明此作的两重读法：表面写雨中绿廊之藤蔓，深层关乎人际故事的缘起。此作四句五言，借一片植物的形态状一种缘起之力的不可见。", "「迥廊椰玉柱」，起句先立空间之骨。「迥廊」是深远的廊道，「椰玉柱」是廊柱被椰叶环绕，柱如玉立——以一桩坚实之物为画面立柱。一句之内空间已成形：廊深且立，下面将要发生的事都在这一根柱之畔。", "「藤叶翠扶疏」，第二句让画面转入植物。「藤叶」是缠绕之物，「翠」是其色之深，「扶疏」是枝叶展开而疏密相间——整体是一种生长的茂盛。一句之中无人，唯有植物的态。", "「柔蔓垂萦纡」，第三句让镜头近至蔓的形态。「柔蔓」是柔软的藤蔓，「垂萦纡」三字状蔓垂下而旋绕的样子——「萦」是缠绕，「纡」是迂回。柔与垂之间的微妙在于：柔者本不能立，唯有借助垂之态才显出形。蔓之美，正在于它能借由垂而成形。", "「谁知雨前初」，末句忽然抛出一个反问。「雨前初」即下雨之前的最初——这一片此刻已茂盛如此的藤蔓，最初之始，谁人知晓？这一问尤为含蓄：当下所见之繁茂，看上去像是自然之常，实则有一个不为人见的起点。一切「滋长」之物，皆由一个无人记得的起点开始。", "四句的弧由廊柱（空间）至藤叶（生长）至柔蔓（形态）至雨前初（起点）。诗人不写此刻之感动，亦不为成长立颂，只在末句轻轻抛出那一桩没有人见证的「初」。题为「滋长」——所滋长之物的特质不在它如何茂盛，而在它的起点几乎无可追溯。人际故事之缘起亦同此理：当下相熟之深，无人记得最初的那一道雨之前是怎样的开始。")
  let asset = "assets/poems/滋长/illustration.png"
  let override = (:)
  render-poem(title, poem_lines, context_note, commentary, asset, override)
}
